{
    "name": "@d.story/apollo-ui",
    "version": "0.2.1",
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "description": "Apollo React UI library",
    "type": "module",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./package.json": "./package.json"
    },
    "files": ["dist"],
    "sideEffects": ["**/*.css"],
    "engines": { "node": ">=22.12.0" },
    "packageManager": "npm@11.19.0",
    "scripts": {
        "dev": "vite --config vite.playground.config.ts --host 0.0.0.0",
        "build": "vite build && tsc -p tsconfig.build.json && node scripts/build-css.mjs",
        "typecheck": "tsc --noEmit && tsc -p checks/consumer --noEmit",
        "check:package": "node scripts/check-package.mjs",
        "check:consumer": "node scripts/check-consumer.mjs",
        "check:publish": "node --test checks/publish.test.mjs",
        "check": "npm run check:publish && npm run typecheck && npm run build && npm run check:package && npm run check:consumer",
        "prepack": "npm run build && npm run check:package"
    },
    "peerDependencies": {
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/node": "24.0.0",
        "@types/react": "19.2.17",
        "@types/react-dom": "19.2.3",
        "@vitejs/plugin-react": "4.7.0",
        "react": "19.2.8",
        "react-dom": "19.2.8",
        "typescript": "5.9.2",
        "vite": "6.4.3"
    }
}
